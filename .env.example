# Supabase (Phase 1 — required for auth + DB + storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Vision API (Phase 1 — fallback OCR when Gemini unavailable)
GOOGLE_VISION_API_KEY=

# Gemini API (Phase 1.12 — primary OCR via gemini-3-flash-preview vision, ~6¢/mois pour 100 scans)
# Get key at https://aistudio.google.com/app/apikey. Enable billing on the linked GCP project for Tier 1 quotas.
GEMINI_API_KEY=

# Anthropic API (Phase 1.5 — used only by scripts/test-bench-claude.ts, NOT in production runtime)
ANTHROPIC_API_KEY=

# Pokémon TCG API (Phase 1 — optional, increases rate limit)
POKEMON_TCG_API_KEY=

# Cardmarket API: removed — they closed the API to new applications (April 2026).
# Card catalog populated via LimitlessTCG scrape instead (see scripts/scrape-limitlesstcg.ts).

# App
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
