# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OCR
# Primary: Gemini 3.1 Flash Lite Preview (~€0.0004/scan).
# Get a key at https://aistudio.google.com/app/apikey, attach it to a GCP
# project with billing enabled to unlock Tier 1 quotas (15 req/min).
GEMINI_API_KEY=
# Fallback: Google Cloud Vision. Free up to 1k units/month, billing required.
GOOGLE_VISION_API_KEY=

# App
# 32-byte hex — protects POST /api/prices/update from random callers.
# Generate with: openssl rand -hex 32
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scrapers (only needed for npm run update-expansions + scrapers/cardmarket)
# BrightData Web Unlocker — token from https://brightdata.com/cp/api_tokens,
# zone name from your dashboard (historically "iris").
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=iris
