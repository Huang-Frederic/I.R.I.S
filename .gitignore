# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/results

# personal card photos used by the bench scripts (user-specific, ~100MB)
/cards_assets

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / Claude Code
.claude/settings.local.json
.vscode/

# Python virtualenvs (defensive — project is 100% TS, but a stray venv shouldn't sneak in)
env/
venv/
.venv/
__pycache__/
*.pyc

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Cardmarket dumps re-downloaded by scripts/upload-cardmarket-dumps.ts.
# The expansion mapping (cardmarket_expansions.json) IS committed — it changes
# only when new sets release (~6×/year, manual re-grab from the CM dropdown).
products_singles_6.json
products_nonsingles_6.json
price_guide_6.json
cardmarket_expansions.html
cardmarket-probe-*.html
cardmarket-input.json

# Generated scraper input from scripts/generate-rescrape-input.ts.
scrapers/cardmarket/.actor/RESCRAPE_INPUT.json

# Local development overrides (optional, not committed)
docs/superpowers/*
docs/AUDIT*
myself.md