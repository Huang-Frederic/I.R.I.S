# Copy to .env and fill in real values — never commit the filled-in file.

# Supabase dashboard → Settings → API
SUPABASE_URL=
SUPABASE_KEY=              # service role key, NOT the anon key

# Optional — only needed if Vinted serves a DataDome CAPTCHA and you want it
# auto-solved. Without these, the bot just logs a warning and keeps going
# without auto-solving when that happens.
CAPSOLVER_KEY=
VINTED_PROXY=               # SOCKS5/HTTP proxy CapSolver can reach, e.g. an ngrok tunnel
